# ============================================================
# APP_LEVEL — dev 또는 prod만 허용. 값이 있는데 dev/prod가 아니면(오타 등)
# 기동이 실패한다. 값 자체가 없으면(줄을 지우거나 빈 값) 자동으로 dev로
# 간주한다 — prod로는 절대 기본 처리하지 않는다.
# 로컬 개발: APP_LEVEL=dev (또는 아예 생략)
# 운영 systemd 서비스: Environment=APP_LEVEL=prod (systemd unit에 반드시
# 명시할 것 — 여기 빠뜨리면 dev로 뜬다)
# ============================================================
APP_LEVEL=dev

# 웹앱이 조회하는 목적지 DB (SELECT-only 계정 사용 권장 — 코드에서도 SELECT만 허용).
# dev: 운영 mielin 복제본/스냅샷을 SELECT-only 계정으로 가리키는 것을 권장한다
# (기본값 예시: mielin 웨어하우스 DB 43.201.172.24). 로컬 DB로 되돌리려면
# 값만 바꾸면 됨.
# prod: localhost의 실제 mielin DB.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_CHARSET=utf8mb4

# OCR 검수 DB — mielin(위 MYSQL_*, 읽기 전용)과 분리된 쓰기용 DB
# (03_ocr_review_schema.sql).
# dev: REVIEW_MYSQL_* 6개 값을 전부 그대로 쓴다. 로컬 MySQL 등 운영과 무관한
# 별도 DB를 가리켜야 한다(운영 계정으로 직접 쓰기하지 말 것).
# prod: APP_LEVEL=prod일 때 앱이 REVIEW_MYSQL_* 6개 값을 전부 무시하고
# MYSQL_* 값을 그대로 재사용한다(운영은 같은 MySQL 서버·같은 mielin DB·
# 같은 계정) — 아래 REVIEW_MYSQL_* 항목은 비워둬도 되지만, 문서화를 위해
# MYSQL_*과 같은 값을 적어두는 것을 권장한다.
# 앱이 실제로 쓰는 계정에는 DELETE를 주지 않는다 (SELECT/INSERT/UPDATE만 —
# 검수 기록은 append-only). 데이터 삭제나 스키마 변경 같은 관리 작업은
# root로 한다
REVIEW_MYSQL_HOST=
REVIEW_MYSQL_PORT=3306
REVIEW_MYSQL_USER=
REVIEW_MYSQL_PASSWORD=
REVIEW_MYSQL_DATABASE=
REVIEW_MYSQL_CHARSET=utf8mb4

# S3 이미지 (선택 사항 — 비워두면 이미지는 플레이스홀더로 표시됨)
# 버킷은 cmaps-hub, 리전은 ap-northeast-2 (오타로 cmpas-hub / us-east-1 아님, 주의)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
S3_BUCKET=cmaps-hub
S3_PRESIGN_EXPIRES_SECONDS=300

# 기타
# 페이지 크기는 화면이 직접 정한다 (검수 그리드 24건 / admin 목록 20건).
# MAX_PAGE_SIZE는 API가 요청받은 page_size를 잘라내는 상한일 뿐이다
REQUEST_TIMEOUT_SECONDS=10
MAX_PAGE_SIZE=100

# 로그인 인증 (Monitor Console)
# 계정은 검수 DB의 ocr_reviewers 테이블에서 관리한다 (username + bcrypt 해시).
# SEED_REVIEWER_PASSWORD는 `uv run python -m scripts.seed_reviewers`가 계정을
# 시딩할 때만 쓰는 값이고, 로그인 검증에는 쓰이지 않는다.
# SESSION_SECRET_KEY는 `python -c "import secrets; print(secrets.token_hex(32))"`로
# 생성한 값을 넣을 것 (커밋 금지)
# SESSION_MAX_AGE_SECONDS는 세션 유효시간이며 비워두면 12시간(43200)이다
SEED_REVIEWER_PASSWORD=
SESSION_SECRET_KEY=
SESSION_MAX_AGE_SECONDS=43200
